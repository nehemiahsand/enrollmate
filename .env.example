# JWT Secret Key
# Generate a secure secret key for production use
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# Database Configuration (used by docker-compose)
POSTGRES_USER=enrollmate
POSTGRES_PASSWORD=enrollmate_password
POSTGRES_DB=enrollmate_db

# Backend Configuration
PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://enrollmate:enrollmate_password@postgres:5432/enrollmate_db

# Frontend Configuration
VITE_API_URL=http://localhost:4000
